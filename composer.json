{
  "name": "ademolaomosanya/atlas",
  "description": "Enterprise WordPress platform for content and digital experiences",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Atlas\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Atlas\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    }
  }
}
